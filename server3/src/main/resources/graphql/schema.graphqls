# ENUM CATEGORÍAS (SIN PUNTO Y COMA FINAL)
enum Categoria {
    ROPA
    ALIMENTOS
    JUGUETES
    UTILES_ESCOLARES
}

# TIPO INFORME (COMPLETO)
type DonacionResumen {
    categoria: Categoria!
    eliminado: Boolean!
    totalCantidad: Int!
}

# INPUT PARA FILTROS
input FiltroDonacionInput {
    categoria: Categoria
    fechaDesde: String
    fechaHasta: String
    eliminado: Boolean
}

# --------------------- FILTROS PERSONALIZADOS ---------------------

type FiltroGuardado {
    id: ID!
    usuario: String!
    nombreFiltro: String!
    categoria: Categoria
    eliminado: Boolean
    fechaDesde: String
    fechaHasta: String
}

input FiltroGuardadoInput {
    nombreFiltro: String!
    categoria: Categoria
    eliminado: Boolean
    fechaDesde: String
    fechaHasta: String
}

# --------------------- QUERIES ---------------------

type Query {
    # Query principal
    informeDonaciones(token: String!, filtro: FiltroDonacionInput): [DonacionResumen!]!
    
    # Obtener todos los filtros guardados del usuario logueado
    obtenerFiltros: [FiltroGuardado!]!
}

# --------------------- MUTATIONS ---------------------

type Mutation {
    # Guardar un nuevo filtro personalizado
    guardarFiltro(filtro: FiltroGuardadoInput!): FiltroGuardado!

    # Actualizar un filtro existente
    actualizarFiltro(id: ID!, filtro: FiltroGuardadoInput!): FiltroGuardado!

    # Eliminar un filtro guardado
    eliminarFiltro(id: ID!): String!
}
